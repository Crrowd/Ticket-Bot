# Weiterleitungen der alten WordPress-Adressen auf die neuen Seiten (Apache-Webspace)
RewriteEngine On

# Freundliche Fehlerseite für Adressen, die es nicht (mehr) gibt
ErrorDocument 404 /404.html

# Alte Seiten-IDs
RewriteCond %{QUERY_STRING} (^|&)page_id=12(&|$)
RewriteRule ^$ /aktuelles.html? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)page_id=1139(&|$)
RewriteRule ^$ /downloads.html? [R=301,L]

# Alte Unterseiten
RewriteRule ^kinderkrippe/?$  /kinderkrippe.html [R=301,L]
RewriteRule ^kindergarten/?$  /kindergarten.html [R=301,L]
RewriteRule ^kinderhort/?$    /kinderhort.html [R=301,L]
RewriteRule ^aktuelles/?$     /aktuelles.html [R=301,L]
RewriteRule ^downloads/?$     /downloads.html [R=301,L]
RewriteRule ^kontakt/?$       /kontakt.html [R=301,L]
RewriteRule ^impressum/?$     /impressum.html [R=301,L]

# Alte PDF-Links
RewriteRule ^wp-content/uploads/.*/Ferienplan_2026_27\.pdf$   /downloads/Ferienplan_2026_27.pdf [R=301,L]
RewriteRule ^wp-content/uploads/.*/HortABC\.pdf$              /downloads/HortABC.pdf [R=301,L]
RewriteRule ^wp-content/uploads/.*/Medikamentenvereinbarung\.pdf$ /downloads/Medikamentenvereinbarung.pdf [R=301,L]

# Interne Arbeitsordner und -dateien nicht ausliefern
RewriteRule ^(entwurf|daten|plans|\.impeccable)(/|$) - [F,L]
RewriteCond %{REQUEST_URI} !^/(robots\.txt|\.well-known/security\.txt)$
RewriteRule \.(py|md|json|txt|csv|log|sh)$ - [F,L]
RewriteRule ^vorschau\.html$ - [F,L]
RewriteRule (^|/)\.(?!well-known/) - [F,L]

# Verzeichnislisten abschalten (falls der Hoster das hier erlaubt; sonst Zeile mit # auskommentieren)
Options -Indexes

# Nur HTTPS: nach dem Umzug einschalten, sobald das SSL-Zertifikat aktiv ist (die drei #-Zeichen entfernen).
# Die zweite Bedingung verhindert eine Endlosschleife bei Hostern mit vorgeschaltetem Proxy.
# RewriteCond %{HTTPS} off
# RewriteCond %{HTTP:X-Forwarded-Proto} !https
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Sicherheits-Header
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  # Strict-Transport-Security erst aktivieren, wenn HTTPS sicher läuft:
  # Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  Header unset X-Powered-By
</IfModule>

# Komprimiert ausliefern (spart am Handy viel Ladezeit)
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/calendar text/vcard application/javascript application/manifest+json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/calendar text/vcard application/javascript application/manifest+json image/svg+xml
</IfModule>

# Kalenderdateien korrekt ausliefern, Caching
AddType text/calendar .ics
AddType image/webp .webp
AddType application/manifest+json .webmanifest
AddType text/vcard .vcf
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  # CSS/JS tragen eine Versionsnummer (?v=…) – deshalb dürfen sie lange zwischengespeichert werden
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
